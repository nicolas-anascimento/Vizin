NODE_ENV=dev
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vizin?schema=public
JWT_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
APP_URL=http://localhost:8080
TRUST_PROXY=false

# SMTP recomendado. Em desenvolvimento, sem SMTP, o link de redefinição aparece no terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Compatibilidade com a configuração antiga por Gmail.
EMAIL_TRANSPORT=
PASSWORD_TRANSPORT=

ADMIN_EMAIL=admin@vizin.local
ADMIN_PASSWORD=troque-esta-senha-forte

# O modo demo só funciona quando NODE_ENV=dev.
PAYMENT_MODE=demo
