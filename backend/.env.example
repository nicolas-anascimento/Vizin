NODE_ENV=dev
PORT=8080
APP_URL=http://localhost:8080
FRONTEND_ORIGINS=http://localhost:8080,http://localhost:5500
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vizin
JWT_KEY=replace-with-a-random-secret-of-at-least-32-characters
PAYMENT_MODE=demo
# Production: PAYMENT_MODE=gateway + MP_ACCESS_TOKEN + MP_WEBHOOK_SECRET. Startup fails when either secret is absent.
# These PAYMENT_GATEWAY_* variables remain for existing legacy HTTP-adapter payments.
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_TOKEN=
PAYMENT_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=
ADMIN_CPF=
ADMIN_PASSWORD=
# Separate database; never point tests at project/production databases.
TEST_DATABASE_URL=

# Official provider for the new contract. Secrets stay exclusively in the backend.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Public HTTPS endpoint; alternatively configure it in Mercado Pago's dashboard.
MP_NOTIFICATION_URL=
# Product decision pending: no monetary fine is enabled until explicitly configured.
MULTA_VALOR_DIA=2
