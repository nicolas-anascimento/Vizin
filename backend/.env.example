NODE_ENV=dev
PORT=8080
APP_URL=http://localhost:8080
FRONTEND_ORIGINS=http://localhost:8080,http://localhost:5500
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vizin
JWT_KEY=replace-with-a-random-secret-of-at-least-32-characters
PAYMENT_MODE=demo
# Production: PAYMENT_MODE=gateway; configure an HTTP adapter for your provider.
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_TOKEN=
PAYMENT_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=
ADMIN_CPF=
ADMIN_PASSWORD=
# Separate database; never point tests at project/production databases.
TEST_DATABASE_URL=
