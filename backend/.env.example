NODE_ENV=dev
PORT=8080
CHAT_ATTACHMENT_MAX_MB=50
APP_URL=http://localhost:8080
FRONTEND_ORIGINS=http://localhost:8080,http://localhost:5500
COOKIE_SAME_SITE=lax
# Tunnel local: confia somente no processo proxy conectado pelo loopback.
# Produção: use IPs/CIDRs explícitos do reverse proxy; o valor true é rejeitado.
TRUST_PROXY=loopback
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vizin
JWT_KEY=replace-with-a-random-secret-of-at-least-32-characters
PAYMENT_MODE=demo
# Production: PAYMENT_MODE=gateway + MP_ACCESS_TOKEN + MP_WEBHOOK_SECRET + MP_NOTIFICATION_URL.
# These PAYMENT_GATEWAY_* variables remain for existing legacy HTTP-adapter payments.
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_TOKEN=
PAYMENT_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP local sem autenticação: configure SMTP_HOST, SMTP_PORT e SMTP_FROM;
# em produção configure também SMTP_USER/SMTP_PASS se exigidos pelo provedor.
# APP_URL precisa ser a URL pública HTTPS usada nos links dos e-mails.
ADMIN_EMAIL=
ADMIN_CPF=
ADMIN_PASSWORD=
# Separate database; never point tests at project/production databases.
TEST_DATABASE_URL=

# Official provider for the new contract. Secrets stay exclusively in the backend.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Public HTTPS endpoint ending in /api/assinaturas/webhook. Required for plan checkout.
MP_NOTIFICATION_URL=
# Product decision pending: no monetary fine is enabled until explicitly configured.
MULTA_VALOR_DIA=2
